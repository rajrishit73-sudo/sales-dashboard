{
  "name": "lumen-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Lumen Studio - AI image generation SaaS (text-to-image, image-to-image, upscaling) with credits and Stripe billing.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.mts",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/billing/webhook"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
