# ---------------------------------------------------------------------------
# Lumen Studio environment
# Copy to .env (both Next.js and the Prisma CLI read it) and fill in what you need.
# The only value required to boot is DATABASE_URL.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# SQLite for local dev. For Postgres, also change `provider` in
# prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a dev fallback is used when unset.
AUTH_SECRET=""

# Absolute URL of this app. Used for Stripe redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Image generation -------------------------------------------------------
# mock | replicate | fal
# "mock" renders deterministic placeholder art locally, so you can use the whole
# product (credits, gallery, billing) without an API key.
PROVIDER="mock"

# --- Replicate (PROVIDER=replicate) ----------------------------------------
# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# Bare "owner/name" uses the official-model endpoint; "owner/name:version"
# pins an exact version. Defaults shown.
REPLICATE_MODEL="black-forest-labs/flux-schnell"
REPLICATE_IMG2IMG_MODEL="black-forest-labs/flux-dev"
REPLICATE_UPSCALE_MODEL="nightmareai/real-esrgan:f121d640bd286e1fdc67f9799164c1d5be36ff74576ee11c803ae5b665dd46aa"
# For SDXL instead of FLUX, set:
#   REPLICATE_MODEL="stability-ai/sdxl:7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd46c929f9bdc"

# --- fal.ai (PROVIDER=fal) --------------------------------------------------
# Key: https://fal.ai/dashboard/keys
FAL_KEY=""
FAL_MODEL="fal-ai/flux/schnell"
FAL_IMG2IMG_MODEL="fal-ai/flux/dev/image-to-image"
FAL_UPSCALE_MODEL="fal-ai/esrgan"

# --- Storage ----------------------------------------------------------------
# local       : download and store images on disk (default; needs a writable
#               volume in production)
# passthrough : keep the provider's CDN URL (no storage cost, but Replicate
#               URLs expire after ~1 hour)
STORAGE_DRIVER="local"
STORAGE_DIR=".data/uploads"

# --- Stripe (test mode) -----------------------------------------------------
# Keys:      https://dashboard.stripe.com/test/apikeys
# Prices:    create two recurring monthly prices and paste their IDs below.
# Webhook:   stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
